{
  "name": "site-school-samocvet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4322",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4323",
    "typecheck": "astro check",
    "format": "prettier --write src scripts tests '*.{json,mjs}' .github/workflows",
    "format:check": "prettier --check src scripts tests '*.{json,mjs}' .github/workflows",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "@fontsource/lora": "^5.2.0",
    "@fontsource/montserrat": "^5.2.0",
    "@fontsource/open-sans": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2"
  }
}
