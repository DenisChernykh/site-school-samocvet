                {
                  "type": "text",
                  "id": "J1gfT",
                  "name": "Что входит в подготовку к школе? · ответ",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Движение и равновесие, стихи и песни, пальчиковые игры, живопись, рукоделие и лепка. Подготовка руки к письму начинается с рисования. В опубликованном анонсе ведущая — Ирина Аркадьевна Толстых.",
                  "lineHeight": 1.5,
                  "fontFamily": "$body",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
