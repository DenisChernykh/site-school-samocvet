                                  "width": "fill_container",
                                  "height": 128.01,
                                  "content": "We believe that learning begins with relationship: to self, to others, and to the living world. At Fieldnote, we nurture whole-child development through open-ended exploration, deep listening, and time spent in nature’s rhythms.",
                                  "lineHeight": 1.6,
                                  "textAlign": "center",
                                  "fontFamily": "Montserrat",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "frame",
                                  "id": "xKA7t",
                                  "name": "spacer",
                                  "width": 448.23,
                                  "height": 16,
                                  "layout": "none"
                                },
                                {
                                  "type": "text",
                                  "id": "Y9lAsk",
                                  "name": "Children are trusted as capable, compete",
                                  "context": "p",
                                  "fill": "#2c2a27",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 102.41,
                                  "content": "Children are trusted as capable, competent, and curious. Our role is to guide, not prescribe - to prepare the soil and tend the environment so growth happens naturally.",
                                  "lineHeight": 1.6,
                                  "textAlign": "center",
                                  "fontFamily": "Montserrat",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        },
