                                {
                                  "type": "text",
                                  "id": "R1blr7",
                                  "name": "At Fieldnote, we believe children learn ",
                                  "context": "p",
                                  "fill": "#2c2a27",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 102.38,
                                  "content": "At Fieldnote, we believe children learn best when they feel known, supported, and free to explore. Our days are shaped by seasons, questions, and real-world experiences - on forest trails, in garden beds, and gathered around stories.",
                                  "lineHeight": 1.6,
                                  "textAlign": "center",
                                  "fontFamily": "Montserrat",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
