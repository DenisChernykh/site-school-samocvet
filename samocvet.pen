                                  "fill": "#2c2a27",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 76.8,
                                  "content": "Inquiry-Led Learning\nWe follow children’s questions and ideas, supporting them with resources, reflection, and trust.",
