                                  "type": "text",
                                  "id": "fsoN2",
                                  "name": "We’re educators, guides, and fellow lear",
                                  "context": "p",
                                  "fill": "#2c2a27",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
