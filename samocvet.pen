                                },
                                {
                                  "type": "text",
                                  "id": "V97NCZ",
                                  "name": "What happens when a group of 4- and 5-ye",
                                  "context": "p",
                                  "fill": "#2c2a27",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 111.99,
                                  "content": "What happens when a group of 4- and 5-year-olds set up a trade system with bark, stones, and a balance scale? Over a week of play, our learners explored fairness, value, and negotiation - without ever calling it math.",
                                  "lineHeight": 1.6,
                                  "fontFamily": "Montserrat",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                },
                                {
