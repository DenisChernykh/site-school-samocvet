                                },
                                {
                                  "type": "text",
                                  "id": "l0gb7H",
                                  "name": "At Fieldnote, we believe children learn ",
                                  "context": "p",
                                  "fill": "#2c2a27",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 128.01,
                                  "content": "At Fieldnote, we believe children learn best when they feel known, supported, and free to explore. Our days are shaped by seasons, questions, and real-world experiences - on forest trails, in garden beds, and gathered around stories.",
                                  "lineHeight": 1.6,
                                  "textAlign": "center",
                                  "fontFamily": "Montserrat",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "frame",
                                  "id": "N2QIP",
                                  "name": "spacer",
                                  "width": 448.23,
                                  "height": 16,
                                  "layout": "none"
                                },
                                {
                                  "type": "text",
                                  "id": "gOu77",
                                  "name": "We’re educators, guides, and fellow lear",
                                  "context": "p",
                                  "fill": "#2c2a27",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 51.2,
                                  "content": "We’re educators, guides, and fellow learners who trust in a child’s natural drive to make meaning.",
                                  "lineHeight": 1.6,
                                  "textAlign": "center",
                                  "fontFamily": "Montserrat",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        }
