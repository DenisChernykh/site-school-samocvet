                          "gap": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "drSF2",
                              "name": "At Fieldnote, we support one another, re",
                              "context": "p",
                              "fill": "#2c2a27",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 76.8,
                              "content": "At Fieldnote, we support one another, reflect often, and co-create a culture of care. Ongoing professional development, mentorship, and voice in program design are part of the work here.",
                              "lineHeight": 1.6,
                              "textAlign": "center",
                              "fontFamily": "Montserrat",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "YtzSW",
                              "name": "We believe that the people guiding child",
                              "context": "p",
                              "fill": "#2c2a27",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 102.41,
                              "content": "We believe that the people guiding children’s learning deserve care, security, and respect. All Fieldnote staff receive a living wage, regardless of role or hours. Pay is transparent, equitable, and increases with responsibility and experience.",
                              "lineHeight": 1.6,
                              "textAlign": "center",
                              "fontFamily": "Montserrat",
                              "fontSize": 16,
                              "fontWeight": "normal"
