                                  ]
                                },
                                {
                                  "type": "text",
                                  "id": "c92pg",
                                  "name": "From field guide observations to spore p",
                                  "context": "p",
                                  "fill": "#2c2a27",
                                  "textGrowth": "fixed-width-height",
                                  "width": "fill_container",
                                  "height": 111.99,
                                  "content": "From field guide observations to spore print experiments, our week was filled with fungi. The children’s curiosity shaped each day’s activities, leading us deeper into decomposition, networks, and naming.",
