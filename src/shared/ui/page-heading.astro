---
import type { Heading } from '@/shared/api/types';
interface Props {
  heading: Heading;
  variant?: string;
}
const { heading, variant } = Astro.props;
---

<section class:list={['page-heading', 'section', variant]}>
  <div class="section-inner text-stack heading-content">
    <slot name="before" />
    <h1 class="multiline">{heading.title}</h1>
    {heading.description && <p class="muted">{heading.description}</p>}
    <slot />
  </div>
</section>
