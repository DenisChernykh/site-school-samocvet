---
import type { Program } from '@/shared/api/types';
import { withBase, media } from '@/shared/lib/paths';
interface Props {
  program: Program;
  home?: boolean;
}
const { program, home = false } = Astro.props;
---

<a
  class:list={['program-card', { 'home-card': home }]}
  href={withBase(`programs/${program.slug}/`)}
  ><div class="card-image">
    <img
      src={media(program.cardImage)}
      alt={program.name}
      loading="lazy"
      decoding="async"
    />
  </div><div class="card-copy">
    <h3>{program.name}</h3>{!home && <p>{program.cardAudience}</p>}<p>
      {home ? program.homeSummary : program.cardSummary}
    </p>{!home && <span class="text-link">Подробнее о формате</span>}
  </div></a
>
<style>
  .program-card {
    display: flex;
    flex-direction: column;
    background: var(--sage);
    border-radius: 20px;
    overflow: hidden;
    transition: transform 250ms ease;
  }
  .program-card:hover {
    transform: translateY(-5px);
  }
  .card-image {
    height: 280px;
    overflow: hidden;
  }
  .card-image img {
    height: 100%;
    object-fit: cover;
    transition: transform 650ms ease;
  }
  .program-card:hover img {
    transform: scale(1.04);
  }
  .card-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 30px 28px;
    text-align: center;
    flex: 1;
  }
  .card-copy h3 {
    font-size: 27px;
    font-style: italic;
  }
  .card-copy .text-link {
    margin-top: auto;
  }
  .home-card .card-image {
    height: 246px;
  }
  .home-card .card-copy {
    padding: 28px 24px;
    align-items: flex-start;
    text-align: left;
    min-height: 242px;
  }
  .home-card h3 {
    font-size: 25px;
  }
  @media (max-width: 760px) {
    .home-card .card-image,
    .card-image {
      height: 260px;
    }
    .home-card .card-copy {
      min-height: 0;
      padding: 28px 24px;
    }
  }
</style>
