---
import type { SiteContent } from '@/shared/api/types';
import PageHeading from '@/shared/ui/page-heading.astro';
import { media, withBase } from '@/shared/lib/paths';
import TextLink from '@/shared/ui/text-link.astro';
interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
const { legal } = content;
---

<PageHeading heading={legal.heading} />
<section class="section legal">
  <div class="section-inner legal-layout">
    <nav class="legal-nav" aria-label="Сведения об организации">
      <a href="#organization">Основные сведения</a>
      <a href="#documents">Документы</a>
      <a href="#education">Образовательные программы</a>
      <a href={withBase('contacts/')}>Контакты организации</a>
    </nav>
    <div class="panel legal-content">
      <section id="organization">
        <h2>{legal.name}</h2>
        <dl class="facts">
          {legal.facts.map((fact) => (
            <div>
              <>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </>
            </div>
          ))}
        </dl>
      </section>
      <section id="documents">
        <h2>Документы</h2>
        <ul class="document-list">
          {legal.documents.map((document) => (
            <li>
              <img
                src={media('document-icon.png')}
                alt=""
                width="22"
                height="22"
              />
              {document}
            </li>
          ))}
        </ul>
      </section>
      <section id="education">
        <h2>Образовательные программы</h2>
        <ul class="document-list">
          {legal.programs.map((program) => (
            <li>{program}</li>
          ))}
        </ul>
      </section>
      <TextLink href={legal.sourceUrl}>Все документы организации</TextLink>
    </div>
  </div>
</section>
