---
import type { SiteContent } from '@/shared/api/types';
import PageHeading from '@/shared/ui/page-heading.astro';
import FeatureSection from '@/shared/ui/feature-section.astro';
import ProgramCard from '@/entities/program/program-card.astro';
import Invitation from '@/widgets/invitation/invitation.astro';
interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
---

<PageHeading heading={content.programsHeading} />
<section class="section catalogue">
  <div class="section-inner program-grid">
    {content.programs.slice(0, 3).map((program) => (
      <ProgramCard program={program} />
    ))}
  </div>
</section>
<FeatureSection
  feature={content.individualIntro}
  reverse
  variant="individual-intro"
/>
<section class="section school-day">
  <div class="section-inner">
    <div class="section-heading">
      <h2 class="multiline">{content.schoolDay.title}</h2>
    </div>
    <div class="day-items">
      {content.schoolDay.items.map((item) => (
        <div>
          <>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </>
        </div>
      ))}
    </div>
    <p class="note muted">{content.schoolDay.note}</p>
  </div>
</section>
<Invitation title="Поможем найти ваш формат" />
