---
import type { SchoolEvent } from '@/shared/api/types';
import { withBase } from '@/shared/lib/paths';
import PageHeading from '@/shared/ui/page-heading.astro';
import Photo from '@/shared/ui/photo.astro';
import TextLink from '@/shared/ui/text-link.astro';
import Invitation from '@/widgets/invitation/invitation.astro';
interface Props {
  event: SchoolEvent;
  contactUrl: string;
}
const { event, contactUrl } = Astro.props;
---

<PageHeading heading={{ title: event.title }}>
  <div slot="before" class="text-stack event-heading-before">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href={withBase('events/')}>Афиша</a>
      <span aria-hidden="true"> / </span>
      <a href={withBase('events/#archive')}>Архив</a>
    </nav>
    <p class="muted">Встреча прошла</p>
  </div>
</PageHeading>
<section class="section event-overview">
  <div class="section-inner story-panel">
    <Photo
      name={event.image}
      alt="Лепка и творческие занятия в Самоцвете"
      ratio="1"
      eager
    />
    <div class="text-stack event-facts">
      <dl class="facts">
        {event.facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>

      <p class="closed">Запись закрыта</p>
      <TextLink href="events/#upcoming">Ближайшие встречи</TextLink>
    </div>
  </div>
</section>
<section class="section event-story">
  <div class="narrow text-stack">
    <h2 class="multiline">{event.story.title}</h2>
    <p class="muted">{event.story.description}</p>
    <ul>
      {event.activities.map((activity) => (
        <li>{activity}</li>
      ))}
    </ul>
  </div>
</section>
<Invitation
  variant="event"
  title="Хотите познакомиться\nсо школой?"
  description="Узнайте о следующей встрече у Ксении."
  label="Написать Ксении"
  href={contactUrl}
/>
