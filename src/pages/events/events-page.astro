---
import type { SiteContent } from '@/shared/api/types';
import PageHeading from '@/shared/ui/page-heading.astro';
import FeatureSection from '@/shared/ui/feature-section.astro';
import Photo from '@/shared/ui/photo.astro';
import Button from '@/shared/ui/button.astro';
import TextLink from '@/shared/ui/text-link.astro';
interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
---

<PageHeading heading={content.events.heading}>
  <nav class="tabs" data-event-nav aria-label="Разделы афиши">
    <a href="#upcoming" aria-current="page">
      Ближайшие
    </a>
    <a href="#archive">Архив</a>
  </nav>
</PageHeading>
<div id="upcoming">
  <FeatureSection
    feature={{ ...content.events.empty, link: undefined }}
    variant="events-empty"
  >
    <Button href={content.site.contactVkUrl}>Спросить о встречах</Button>
    <TextLink href={content.site.vkUrl}>События в ВКонтакте</TextLink>
  </FeatureSection>
</div>
<section class="section archive" id="archive">
  <div class="section-inner">
    <div class="section-heading">
      <h2>{content.events.archiveHeading}</h2>
    </div>
    <div class="archive-grid">
      {content.events.items.map((event) => (
        <article class="archive-event">
          <>
            <Photo
              name={event.image}
              alt="Творческая работа детей в школе"
              ratio="1.35"
            />
            <div class="text-stack">
              <>
                <p class="date muted">{event.dateLabel}</p>
                <h3>Открытая семейная встреча</h3>
                <p>{event.description}</p>
                <p class="closed">Встреча прошла · запись закрыта</p>
                <TextLink href={`events/${event.slug}/`}>
                  Посмотреть встречу
                </TextLink>
              </>
            </div>
          </>
        </article>
      ))}
    </div>
  </div>
</section>
<script>
  const navigation = document.querySelector('[data-event-nav]');
  function updateEventNav() {
    const selected =
      window.location.hash === '#archive' ? '#archive' : '#upcoming';
    navigation?.querySelectorAll('a').forEach((link) => {
      if (link.getAttribute('href') === selected)
        link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }
  updateEventNav();
  window.addEventListener('hashchange', updateEventNav);
</script>
