---
import type { Program } from '@/shared/api/types';
import { withBase } from '@/shared/lib/paths';
import PageHeading from '@/shared/ui/page-heading.astro';
import FeatureSection from '@/shared/ui/feature-section.astro';
import Photo from '@/shared/ui/photo.astro';
import Button from '@/shared/ui/button.astro';
interface Props {
  program: Program;
  contactUrl: string;
}
const { program, contactUrl } = Astro.props;
const preschool = program.slug === 'preschool';
const afterSchool = program.slug === 'after-school';
const panels = preschool
  ? program.details.items.map((item) => [item])
  : [program.details.items.slice(0, 2), program.details.items.slice(2)];
---

<PageHeading heading={program.heading}>
  <nav slot="before" class="breadcrumbs" aria-label="Хлебные крошки">
    <a href={withBase('programs/')}>Направления</a>
    <span aria-hidden="true">/</span>
    <span>{program.name}</span>
  </nav>
</PageHeading>
<section class="section program-overview">
  <div class="section-inner overview">
    <Photo name={program.image} alt={program.name} ratio="1.76" eager />
    <div
      class:list={[
        'text-stack',
        'conditions',
        { 'preschool-conditions': preschool },
      ]}
    >
      <dl class="facts">
        {program.facts.map((fact) => (
          <div class:list={{ 'small-fact': fact.label === 'Формат' }}>
            <>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </>
          </div>
        ))}
      </dl>
      <Button href={contactUrl}>{program.actionLabel}</Button>
    </div>
  </div>
</section>
<section
  class:list={[
    'section',
    'details',
    { 'preschool-details': preschool, 'after-school-details': afterSchool },
  ]}
>
  <div class="section-inner">
    <div class="section-heading">
      <h2 class="multiline">{program.details.title}</h2>
    </div>
    <div class:list={['panel-grid', { 'topics-grid': preschool }]}>
      {afterSchool
        ? program.details.items.map((item) => (
            <div class="discussion-item">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))
        : panels.map((items, index) => (
            <div class:list={['panel', { sage: index === 1 && !preschool }]}>
              <div class="items">
                {items.map((item) => (
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </div>
                ))}
              </div>
            </div>
          ))}
    </div>
  </div>
</section>
<FeatureSection
  feature={program.story}
  variant={`program-story ${program.slug === 'preschool' ? 'preschool-story' : ''}`}
/>
<section class="section start">
  <div class="narrow text-stack center">
    <h2>{program.start.title}</h2>
    <p>{program.start.description}</p>
    <Button href={contactUrl}>Написать Ксении</Button>
  </div>
</section>
