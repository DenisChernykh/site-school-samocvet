---
import type { SiteContent } from '@/shared/api/types';
import { media } from '@/shared/lib/paths';
import FeatureSection from '@/shared/ui/feature-section.astro';
import Button from '@/shared/ui/button.astro';
import TextLink from '@/shared/ui/text-link.astro';
import Invitation from '@/widgets/invitation/invitation.astro';
interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
const { about } = content;
---

<FeatureSection
  feature={{ ...about.intro, link: undefined }}
  mainHeading
  reverse
  variant="about-intro"
>
  <Button href="team/">Познакомиться с педагогами</Button>
  <TextLink href="admission/">Как познакомиться со школой</TextLink>
</FeatureSection>
<section class="section principles">
  <div class="section-inner">
    <div class="section-heading">
      <h2 class="multiline">{about.principles.title}</h2>
    </div>
    <div class="panel-grid">
      {about.principles.panels.map((panel, index) => (
        <div class:list={['panel', { sage: index === 1 }]}>
          <>
            <h3>{panel.title}</h3>
            <div class="items">
              {panel.items.map((item) => (
                <div>
                  <h4>{item.title}</h4>
                  <p>{item.description}</p>
                </div>
              ))}
            </div>
          </>
        </div>
      ))}
    </div>
  </div>
</section>
<section class="statement light">
  <img src={media('school-04.webp')} alt="" loading="lazy" />
  <h2 class="multiline">{about.statement}</h2>
</section>
<FeatureSection feature={about.family} variant="about-family" />
<Invitation />
