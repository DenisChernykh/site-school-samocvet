---
import type { SiteContent } from '@/shared/api/types';
import Hero from '@/widgets/hero/hero.astro';
import InquiryForm from '@/features/inquiry/ui/inquiry-form.astro';
import TextLink from '@/shared/ui/text-link.astro';
interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
const { admission, site } = content;
---

<Hero hero={admission.hero} compact />
<section class="section admission-process">
  <div class="section-inner">
    <div class="section-heading">
      <h2 class="multiline">{admission.steps.title}</h2>
      <p>{admission.steps.description}</p>
    </div>
    <ol class="admission-steps">
      {admission.steps.items.map((step) => (
        <li>
          <div class="timeline-card">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<section class="section" id="inquiry">
  <div class="narrow split inquiry-layout">
    <div class="text-stack">
      <h2>
        Расскажите
        <br />о вашей семье
      </h2>
      <p>
        Ксения помогает новым семьям познакомиться со школой и выбрать следующий
        шаг.
      </p>
      <a href={site.phoneHref}>{site.phone}</a>
      <TextLink href={site.contactVkUrl}>Написать в ВКонтакте</TextLink>
    </div>
    <InquiryForm source="admission" contactUrl={site.contactVkUrl} />
  </div>
</section>
<section class="section faq">
  <div class="section-inner faq-layout">
    <h2>О чём спрашивают семьи</h2>
    <div>
      {admission.faqs.map((item, index) => (
        <details open>
          <>
            <summary>
              {index < 4 && <span class="plus" aria-hidden="true" />}
              {item.title}
            </summary>
            <p>{item.description}</p>
          </>
        </details>
      ))}
    </div>
  </div>
</section>
