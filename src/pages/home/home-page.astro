---
import type { SiteContent } from '@/shared/api/types';
import { media } from '@/shared/lib/paths';
import Hero from '@/widgets/hero/hero.astro';
import Invitation from '@/widgets/invitation/invitation.astro';
import ProgramCard from '@/entities/program/program-card.astro';
import Photo from '@/shared/ui/photo.astro';
import Button from '@/shared/ui/button.astro';
import TextLink from '@/shared/ui/text-link.astro';
interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
const { home } = content;
---

<Hero hero={home.hero} />
<section class="section home-intro">
  <div class="section-inner split">
    <div class="reveal">
      <Photo
        name={home.intro.image}
        alt="Педагог и дети в семейной школе"
        framed
        ratio="1.065"
      />
    </div>
    <div class="text-stack center">
      <h2 class="multiline">{home.intro.title}</h2>
      <div class="intro-desktop">
        {home.intro.paragraphs?.map((p) => (
          <p>{p}</p>
        ))}
      </div>
      <p class="intro-mobile">
        Сообщество семей и педагогов для детей на семейном обучении.
        Вальдорфский подход, творчество, проекты и походы — с вниманием к
        каждому ребёнку.
      </p>
      <Button href="about/">О школе</Button>
    </div>
  </div>
</section>
<section class="values light" aria-label="Три опоры школы">
  <div class="section-inner values-grid">
    {home.values.map((value) => (
      <div class="value">
        <>
          <img
            src={media(value.image)}
            alt=""
            width="104"
            height="104"
            loading="lazy"
          />
          <h2>{value.title}</h2>
          <p class="value-desktop">{value.description}</p>
          <p class="value-mobile">{value.mobileDescription}</p>
        </>
      </div>
    ))}
  </div>
</section>
<section class="section" id="programs">
  <div class="section-inner">
    <div class="section-heading">
      <h2>{home.programsTitle}</h2>
      <TextLink href="programs/" class="desktop-copy">
        Все направления
      </TextLink>
    </div>
    <div class="home-programs">
      {content.programs.map((program) => (
        <ProgramCard program={program} home />
      ))}
    </div>
    <TextLink href="programs/" class="mobile-copy all-programs">
      Все направления
    </TextLink>
  </div>
</section>
<section class="section home-stories">
  <div class="section-inner">
    <div class="section-heading">
      <h2 class="multiline">{home.storiesTitle}</h2>
      <TextLink href="life/">Жизнь школы</TextLink>
    </div>
    <div class="story-columns">
      {home.stories.map((story) => (
        <article class="story reveal">
          <>
            <Photo name={story.image} alt={story.title} ratio="1.3" />
            <h3>{story.title}</h3>
            <p>{story.description}</p>
          </>
        </article>
      ))}
    </div>
    <div class="mobile-story">
      <Photo
        name="school-19.webp"
        alt="Общий поход семей и педагогов"
        ratio="1.315"
      />
      <p class="muted">
        Походы, мастерские, проекты и праздники — вместе с семьями и педагогами.
      </p>
      <TextLink href="life/">Жизнь школы</TextLink>
    </div>
  </div>
</section>
<section class="section home-events">
  <div class="section-inner events-layout">
    <div class="text-stack events-copy">
      <h2 class="multiline">{home.events.title}</h2>
      <p class="muted desktop-copy">{home.events.description}</p>
      <p class="muted mobile-copy">{home.events.mobileDescription}</p>
    </div>
    <div class="text-stack events-actions">
      <Button href="events/">Открыть афишу</Button>
      <TextLink href="events/#archive">
        <span class="desktop-copy">Посмотреть прошедшие встречи</span>
        <span class="mobile-copy">Прошедшие встречи</span>
      </TextLink>
    </div>
  </div>
</section>
<section class="section home-quote">
  <blockquote class="multiline">{home.quote.text}</blockquote>
  <p class="muted">{home.quote.author}</p>
</section>
<Invitation photo />
