---
import { withBase } from '@/shared/lib/paths';
interface Props {
  source: 'admission' | 'contacts';
  label?: string;
}
const { source, label = 'Записаться на знакомство' } = Astro.props;
const id = `inquiry-${source}`;
---

<div class="inquiry-widget" data-inquiry-widget>
  <p class="preview-note">
    Демонстрационная форма. Данные не сохраняются и не отправляются в школу.
  </p>
  <form data-inquiry-form data-source={source}>
    <div class="field">
      <label for={`${id}-name`}>Ваше имя</label><input
        id={`${id}-name`}
        name="name"
        placeholder="Как к вам обращаться"
        autocomplete="name"
        required
        minlength="2"
        maxlength="80"
        aria-describedby={`${id}-name-error`}
      /><p class="field-error" id={`${id}-name-error`} data-error="name" hidden>
      </p>
    </div>
    <div class="field">
      <label for={`${id}-contact`}>Телефон или контакт в VK</label><input
        id={`${id}-contact`}
        name="contact"
        type="text"
        placeholder="Оставьте удобный способ связи"
        autocomplete="tel"
        required
        maxlength="160"
        aria-describedby={`${id}-contact-error`}
      /><p
        class="field-error"
        id={`${id}-contact-error`}
        data-error="contact"
        hidden
      >
      </p>
    </div>
    <div class="field">
      <label for={`${id}-message`}
        >Ваш вопрос <span class="optional">(необязательно)</span></label
      ><textarea
        id={`${id}-message`}
        name="message"
        rows="4"
        placeholder={source === 'contacts'
          ? 'Что вы хотите узнать о школе?'
          : 'Расскажите о ребёнке и своих ожиданиях'}
        maxlength="2000"
        aria-describedby={`${id}-message-error`}></textarea><p
        class="field-error"
        id={`${id}-message-error`}
        data-error="message"
        hidden
      >
      </p>
    </div>
    <div>
      <label class="consent" for={`${id}-consent`}
        ><input
          id={`${id}-consent`}
          type="checkbox"
          name="consent"
          required
          aria-describedby={`${id}-consent-error`}
        /><span
          >Даю согласие на обработку персональных данных. <a
            href={withBase('privacy/')}>Политика обработки данных.</a
          ></span
        ></label
      ><p
        class="field-error"
        id={`${id}-consent-error`}
        data-error="consent"
        hidden
      >
      </p>
    </div>
    <p class="form-error" role="alert" hidden></p>
    <button class="button" type="submit" disabled>{label}</button>
    <noscript
      ><p>
        Для проверки формы включите JavaScript. Связаться со школой можно по
        телефону или в VK.
      </p></noscript
    >
  </form>
  <div class="form-result" role="status" tabindex="-1" hidden>
    <h3>Форма заполнена</h3><p>
      Это демонстрация: заявка не отправлена. Чтобы договориться о встрече,
      свяжитесь с Ксенией по телефону или в VK.
    </p><button class="button" type="button" data-reset
      >Заполнить ещё раз</button
    >
  </div>
</div>

<script>
  import { submitInquiry } from '../api/submit-inquiry';
  import type { Inquiry, InquiryField } from '@/shared/api/types';
  document
    .querySelectorAll<HTMLElement>('[data-inquiry-widget]')
    .forEach((widget) => {
      const form = widget.querySelector<HTMLFormElement>('form')!;
      const submit = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      )!;
      const result = widget.querySelector<HTMLElement>('.form-result')!;
      const generalError = widget.querySelector<HTMLElement>('.form-error')!;
      const originalLabel = submit.textContent;
      form.noValidate = true;
      submit.disabled = false;
      function clearErrors() {
        form
          .querySelectorAll<HTMLElement>('[data-error]')
          .forEach((element) => {
            element.textContent = '';
            element.hidden = true;
          });
        form
          .querySelectorAll('[aria-invalid]')
          .forEach((element) => element.removeAttribute('aria-invalid'));
        generalError.hidden = true;
      }
      form.addEventListener('input', (event) => {
        const field = event.target as HTMLInputElement;
        field.removeAttribute('aria-invalid');
        const error = form.querySelector<HTMLElement>(
          `[data-error="${field.name}"]`,
        );
        if (error) error.hidden = true;
      });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit.disabled) return;
        clearErrors();
        const data = new FormData(form);
        const inquiry: Inquiry = {
          name: String(data.get('name') ?? ''),
          contact: String(data.get('contact') ?? ''),
          message: String(data.get('message') ?? ''),
          consent: data.has('consent'),
          source: form.dataset.source as Inquiry['source'],
        };
        submit.disabled = true;
        submit.textContent = 'Проверяем…';
        form.setAttribute('aria-busy', 'true');
        try {
          const response = await submitInquiry(inquiry);
          if (response.status === 'invalid') {
            for (const [field, message] of Object.entries(response.errors)) {
              const error = form.querySelector<HTMLElement>(
                `[data-error="${field}"]`,
              )!;
              error.textContent = message;
              error.hidden = false;
              (form.elements.namedItem(field) as HTMLElement)?.setAttribute(
                'aria-invalid',
                'true',
              );
            }
            const first = Object.keys(response.errors)[0] as InquiryField;
            (form.elements.namedItem(first) as HTMLElement)?.focus();
          } else {
            form.hidden = true;
            result.hidden = false;
            result.focus();
          }
        } catch {
          generalError.textContent =
            'Не удалось проверить форму. Попробуйте ещё раз или свяжитесь со школой в VK.';
          generalError.hidden = false;
        } finally {
          submit.disabled = false;
          submit.textContent = originalLabel;
          form.removeAttribute('aria-busy');
        }
      });
      widget.querySelector('[data-reset]')?.addEventListener('click', () => {
        form.reset();
        clearErrors();
        result.hidden = true;
        form.hidden = false;
        (form.elements.namedItem('name') as HTMLElement)?.focus();
      });
    });
</script>
<style>
  .inquiry-widget {
    min-width: 0;
  }
  .preview-note {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    margin-bottom: 20px;
  }
  form {
    display: grid;
    gap: 24px;
  }
  .field {
    display: grid;
    gap: 8px;
  }
  label {
    font-size: 14px;
  }
  .optional {
    color: var(--muted);
    font-size: 12px;
  }
  input:not([type='checkbox']),
  textarea {
    width: 100%;
    border: 1px solid var(--forest);
    border-radius: 4px;
    background: transparent;
    color: var(--ink);
    padding: 12px 16px;
    font-size: 16px;
    min-height: 48px;
  }
  textarea {
    resize: vertical;
    min-height: 120px;
  }
  ::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  .consent {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding-block: 10px;
    min-height: 44px;
    cursor: pointer;
  }
  .consent input {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin: 2px 0 0;
    accent-color: var(--button);
  }
  .consent a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .field-error,
  .form-error {
    font-size: 14px;
    color: #9b342c;
    line-height: 1.5;
  }
  [aria-invalid='true'] {
    border-color: #9b342c !important;
  }
  .form-result {
    display: grid;
    gap: 24px;
    border: 2px dashed var(--forest);
    border-radius: 20px;
    padding: 32px;
  }
  .form-result:focus {
    outline: none;
  }
  .form-result h3 {
    font-size: 30px;
  }
  form > .button,
  .form-result > .button {
    justify-self: start;
  }
</style>
