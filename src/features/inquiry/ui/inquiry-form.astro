---
import Button from '@/shared/ui/button.astro';
import { media, withBase } from '@/shared/lib/paths';
interface Props {
  source: 'admission' | 'contacts';
  contactUrl: string;
  label?: string;
  title?: string;
}
const {
  source,
  title,
  contactUrl,
  label = 'Записаться на знакомство',
} = Astro.props;
const id = `inquiry-${source}`;
---

<div class="inquiry-widget" data-inquiry-widget>
  {title && <h2 class="form-title">{title}</h2>}
  <p class="preview-note">Демо: данные не сохраняются и не отправляются.</p>
  <form data-inquiry-form data-source={source}>
    <div class="field">
      <label for={`${id}-name`}>Ваше имя</label>
      <input
        id={`${id}-name`}
        name="name"
        placeholder="Как к вам обращаться"
        autocomplete="name"
        required
        minlength="2"
        maxlength="80"
        aria-describedby={`${id}-name-error`}
      />
      <p
        class="field-error"
        id={`${id}-name-error`}
        data-error="name"
        hidden
      ></p>
    </div>
    <div class="field">
      <label for={`${id}-contact`}>Телефон или контакт в VK</label>
      <input
        id={`${id}-contact`}
        name="contact"
        type="text"
        placeholder="Оставьте удобный способ связи"
        autocomplete="tel"
        required
        maxlength="160"
        aria-describedby={`${id}-contact-error`}
      />
      <p
        class="field-error"
        id={`${id}-contact-error`}
        data-error="contact"
        hidden
      ></p>
    </div>
    <div class="field">
      <label for={`${id}-message`}>Ваш вопрос</label>
      <textarea
        id={`${id}-message`}
        name="message"
        rows="4"
        placeholder={
          source === 'contacts'
            ? 'Что вы хотите узнать о школе?'
            : 'Расскажите о ребёнке и своих ожиданиях'
        }
        maxlength="2000"
        aria-describedby={`${id}-message-error`}
      ></textarea>
      <p
        class="field-error"
        id={`${id}-message-error`}
        data-error="message"
        hidden
      ></p>
    </div>
    <div>
      <label class="consent" for={`${id}-consent`}>
        <input
          id={`${id}-consent`}
          type="checkbox"
          name="consent"
          required
          aria-describedby={`${id}-consent-error`}
        />
        <span>
          Даю согласие на обработку персональных данных.{' '}
          <a href={withBase('privacy/')}>Политика обработки данных.</a>
        </span>
      </label>
      <p
        class="field-error"
        id={`${id}-consent-error`}
        data-error="consent"
        hidden
      ></p>
    </div>
    <p class="form-error" role="alert" hidden></p>
    <button class="button" type="submit" disabled>
      {label}
    </button>
    <noscript>
      <p>
        Для проверки формы включите JavaScript. Связаться со школой можно по
        телефону или в VK.
      </p>
    </noscript>
  </form>
  <div class="form-result" role="status" tabindex="-1" hidden>
    <img src={media('confirmation-icon.png')} width="40" height="40" alt="" />
    <h1>
      Спасибо
      <br />
      за знакомство
    </h1>
    <p>
      Пример подтверждения после отправки: школа получает обращение и
      связывается с семьёй по указанному контакту. В демонстрационном макете
      обращение не отправляется.
    </p>
    <Button href="">Вернуться на главную</Button>
    <p class="direct-contact">
      Если удобнее —{' '}
      <a href={contactUrl} target="_blank" rel="noopener noreferrer">
        напишите Ксении в VK.
      </a>
    </p>
  </div>
</div>

<script>
  import { submitInquiry } from '../api/submit-inquiry';
  import type { Inquiry, InquiryField } from '@/shared/api/types';
  document
    .querySelectorAll<HTMLElement>('[data-inquiry-widget]')
    .forEach((widget) => {
      const form = widget.querySelector<HTMLFormElement>('form')!;
      const submit = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      )!;
      const result = widget.querySelector<HTMLElement>('.form-result')!;
      const generalError = widget.querySelector<HTMLElement>('.form-error')!;
      const originalLabel = submit.textContent;
      form.noValidate = true;
      submit.disabled = false;
      function clearErrors() {
        form
          .querySelectorAll<HTMLElement>('[data-error]')
          .forEach((element) => {
            element.textContent = '';
            element.hidden = true;
          });
        form
          .querySelectorAll('[aria-invalid]')
          .forEach((element) => element.removeAttribute('aria-invalid'));
        generalError.hidden = true;
      }
      form.addEventListener('input', (event) => {
        const field = event.target as HTMLInputElement;
        field.removeAttribute('aria-invalid');
        const error = form.querySelector<HTMLElement>(
          `[data-error="${field.name}"]`,
        );
        if (error) error.hidden = true;
      });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submit.disabled) return;
        clearErrors();
        const data = new FormData(form);
        const inquiry: Inquiry = {
          name: String(data.get('name') ?? ''),
          contact: String(data.get('contact') ?? ''),
          message: String(data.get('message') ?? ''),
          consent: data.has('consent'),
          source: form.dataset.source as Inquiry['source'],
        };
        submit.disabled = true;
        submit.textContent = 'Проверяем…';
        form.setAttribute('aria-busy', 'true');
        try {
          const response = await submitInquiry(inquiry);
          if (response.status === 'invalid') {
            for (const [field, message] of Object.entries(response.errors)) {
              const error = form.querySelector<HTMLElement>(
                `[data-error="${field}"]`,
              )!;
              error.textContent = message;
              error.hidden = false;
              (form.elements.namedItem(field) as HTMLElement)?.setAttribute(
                'aria-invalid',
                'true',
              );
            }
            const first = Object.keys(response.errors)[0] as InquiryField;
            (form.elements.namedItem(first) as HTMLElement)?.focus();
          } else {
            form.hidden = true;
            result.hidden = false;
            const main = document.querySelector('main');
            main?.prepend(result);
            main?.classList.add('inquiry-confirmed');
            document.querySelector('header')?.classList.remove('overlay');
            document.querySelector('footer')?.setAttribute('hidden', '');
            window.scrollTo({ top: 0, behavior: 'instant' });
            result.focus({ preventScroll: true });
          }
        } catch {
          generalError.textContent =
            'Не удалось проверить форму. Попробуйте ещё раз или свяжитесь со школой в VK.';
          generalError.hidden = false;
        } finally {
          submit.disabled = false;
          submit.textContent = originalLabel;
          form.removeAttribute('aria-busy');
        }
      });
    });
</script>
<style>
  .inquiry-widget {
    min-width: 0;
    padding: 32px;
    outline: 2px dashed var(--forest);
    outline-offset: -1px;
    border-radius: 20px;
  }
  .form-title {
    font-size: 30px;
    line-height: 1.2;
    margin-bottom: 24px;
  }
  @media (max-width: 760px) {
    .inquiry-widget {
      padding: 24px;
    }
    .form-title {
      font-size: 28px;
    }
  }
  .preview-note {
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
    margin-bottom: 18px;
  }
  form {
    display: grid;
    gap: 18px;
  }
  .field {
    display: grid;
    gap: 8px;
  }
  label {
    line-height: 1.5;
    font-weight: 600;
    font-size: 14px;
  }
  .optional {
    color: var(--muted);
    font-size: 12px;
  }
  input:not([type='checkbox']),
  textarea {
    width: 100%;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--sage);
    color: var(--ink);
    padding: 12px 16px;
    font-size: 16px;
    min-height: 56px;
  }
  textarea {
    resize: vertical;
    min-height: 104px;
    height: 104px;
  }
  ::placeholder {
    font-size: 13px;
    color: var(--muted);
    opacity: 1;
  }
  .consent {
    font-weight: 400;
    line-height: 1.5;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding-block: 10px;
    min-height: 44px;
    cursor: pointer;
  }
  .consent input {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin: 2px 0 0;
    accent-color: var(--button);
  }
  .consent a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .field-error,
  .form-error {
    font-size: 14px;
    color: #974f46;
    line-height: 1.5;
  }
  .field-error {
    font-size: 12px;
  }
  [aria-invalid='true'] {
    border-color: #974f46 !important;
  }
  :global(main.inquiry-confirmed > :not(.form-result)) {
    display: none;
  }
  .form-result {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    padding: 92px 24px;
    width: 100%;
    max-width: 728px;
    margin-inline: auto;
  }
  .form-result:focus {
    outline: none;
  }
  .form-result img {
    width: 40px;
    height: 40px;
  }
  .form-result h1 {
    font-size: 35px;
    line-height: 1.2;
  }
  .form-result p {
    color: var(--muted);
    line-height: 1.6;
  }
  .form-result .direct-contact {
    font-size: 14px;
  }
  .direct-contact a:hover {
    text-decoration: underline;
  }
  form > .button {
    justify-self: start;
  }
</style>
