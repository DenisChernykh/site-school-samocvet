---
import type { Hero } from '@/shared/api/types';
import { media } from '@/shared/lib/paths';
import Button from '@/shared/ui/button.astro';
interface Props {
  hero: Hero;
  compact?: boolean;
}
const { hero, compact = false } = Astro.props;
---

<section class:list={['hero', { compact }]}>
  <picture aria-hidden="true">
    {hero.mobileImage && (
      <source media="(max-width:760px)" srcset={media(hero.mobileImage)} />
    )}
    <img src={media(hero.image)} alt="" fetchpriority="high" decoding="async" />
  </picture>
  <div class="hero-content">
    <h1 class="multiline">{hero.title}</h1>
    <p class:list={['multiline', { 'desktop-copy': !!hero.mobileDescription }]}>
      {hero.description}
    </p>
    {hero.mobileDescription && (
      <p class="multiline mobile-copy">{hero.mobileDescription}</p>
    )}
    <Button href={hero.action.href}>{hero.action.label}</Button>
  </div>
</section>
<style>
  .hero {
    position: relative;
    height: min(820px, 100svh);
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cream);
    background: var(--forest);
  }
  picture {
    position: absolute;
    inset: 0;
  }
  picture::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #374036ae;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    width: 100%;
    padding: 96px 120px 42px;
    text-align: center;
  }
  h1 {
    font-size: 56px;
    line-height: 1.14;
  }
  p {
    max-width: 770px;
    font:
      20px/1.4 Lora,
      serif;
  }
  .compact {
    height: 700px;
    min-height: 0;
    display: block;
  }
  .compact picture::after {
    background: linear-gradient(
      90deg,
      #344537f0 0%,
      #344537ab 55%,
      #34453766 100%
    );
  }
  .compact .hero-content {
    width: min(640px, 100%);
    padding: 192px 96px 0;
    gap: 22px;
    align-items: flex-start;
    text-align: left;
  }
  .compact h1 {
    font-size: 52px;
    line-height: 1.2;
  }
  .compact p {
    font:
      16px/1.5 Montserrat,
      sans-serif;
  }
  @media (max-width: 760px) {
    .hero {
      height: 740px;
      min-height: 0;
    }
    .hero-content {
      gap: 26px;
      padding: 96px 24px 32px;
    }
    h1 {
      font-size: 33px;
      line-height: 1.2;
    }
    p {
      font-size: 17px;
      line-height: 1.5;
    }
    .compact picture::after {
      background: linear-gradient(
        180deg,
        #344537f0 0%,
        #344537ab 72%,
        #34453766 100%
      );
    }
    .compact {
      height: 660px;
    }
    .compact .hero-content {
      padding: 170px 24px 0;
      gap: 22px;
    }
    .compact h1 {
      font-size: 38px;
    }
    .compact p {
      line-height: 1.6;
    }
  }
</style>
