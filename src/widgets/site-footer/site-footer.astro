---
import type { SiteContent } from '@/shared/api/types';
import { withBase } from '@/shared/lib/paths';
interface Props {
  site: SiteContent['site'];
}
const { site } = Astro.props;
const groups = [
  {
    name: 'Школа',
    links: [
      ['Наш подход', 'about/'],
      ['Педагоги', 'team/'],
      ['Жизнь школы', 'life/'],
    ],
  },
  {
    name: 'Для семьи',
    links: [
      ['Направления', 'programs/'],
      ['Знакомство и поступление', 'admission/'],
      ['Афиша', 'events/'],
    ],
  },
  {
    name: 'Связь',
    links: [
      ['Контакты', 'contacts/'],
      ['ВКонтакте', site.vkUrl],
      ['Сведения об организации', 'legalinfo/'],
    ],
  },
];
---

<footer class="site-footer section">
  <div class="footer-content">
    <div class="footer-links">
      {groups.map((group) => (
        <div>
          <h2>{group.name}</h2>
          <ul>
            {group.links.map(([label, href]) => (
              <li>
                <a
                  href={href.startsWith('https:') ? href : withBase(href)}
                  target={href.startsWith('https:') ? '_blank' : undefined}
                  rel={
                    href.startsWith('https:')
                      ? 'noopener noreferrer'
                      : undefined
                  }
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-identity">
      <a class="footer-brand" href={withBase()}>
        {site.name}
      </a>
      <address>
        {site.address}
        <br />
        {site.addressDetail}
      </address>
    </div>
  </div>
  <p class="footer-meta">
    Семейная инициатива «Самоцвет» ·{' '}
    <a href={withBase('privacy/')}>Политика обработки данных</a>
  </p>
</footer>
<style>
  .site-footer {
    text-align: center;
    padding-block: 72px;
  }
  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 44px;
  }
  .footer-links {
    width: min(900px, 100%);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 52px;
  }
  .footer-links h2 {
    font-size: 20px;
    line-height: 1.5;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    gap: 12px;
  }
  li a {
    display: block;
    font-size: 14px;
    line-height: 1.5;
    color: var(--link);
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer-identity {
    display: grid;
    gap: 16px;
  }
  .footer-brand {
    font:
      46px/1.5 Lora,
      serif;
  }
  address {
    font-style: normal;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .footer-meta {
    margin-top: 36px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .site-footer {
      padding-block: 60px;
    }
    .footer-links {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .footer-identity {
      order: -1;
    }
    .footer-brand {
      font-size: 38px;
    }
  }
</style>
