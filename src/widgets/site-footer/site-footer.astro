---
import type { SiteContent } from '@/shared/api/types';
import { withBase } from '@/shared/lib/paths';
interface Props {
  site: SiteContent['site'];
}
const { site } = Astro.props;
const groups = [
  {
    name: 'Школа',
    links: [
      ['Наш подход', 'about/'],
      ['Педагоги', 'team/'],
      ['Жизнь школы', 'life/'],
    ],
  },
  {
    name: 'Для семьи',
    links: [
      ['Направления', 'programs/'],
      ['Знакомство и поступление', 'admission/'],
      ['Афиша', 'events/'],
    ],
  },
  {
    name: 'Связь',
    links: [
      ['Контакты', 'contacts/'],
      ['ВКонтакте', site.vkUrl],
      ['Сведения об организации', 'legalinfo/'],
    ],
  },
];
---

<footer class="section">
  <div class="footer-links">
    {
      groups.map((group) => (
        <div>
          <>
            <h2>{group.name}</h2>
            <ul>
              {group.links.map(([label, href]) => (
                <li>
                  <a
                    href={href.startsWith('https:') ? href : withBase(href)}
                    target={href.startsWith('https:') ? '_blank' : undefined}
                    rel={
                      href.startsWith('https:')
                        ? 'noopener noreferrer'
                        : undefined
                    }
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </>
        </div>
      ))
    }
  </div>
  <a class="footer-brand" href={withBase()}>{site.name}</a>
  <address>{site.address}<br />{site.addressDetail}</address>
  <p class="footer-meta">
    Семейная инициатива «Самоцвет» · <a href={withBase('privacy/')}
      >Политика обработки данных</a
    >
  </p>
  <p class="demo-note">Демонстрационная версия · формы не отправляют заявки</p>
</footer>
<style>
  footer {
    text-align: center;
    padding-block: 72px;
  }
  .footer-links {
    max-width: 900px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 52px;
    margin: 0 auto 44px;
  }
  .footer-links h2 {
    font-size: 20px;
    line-height: 1.5;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
  }
  li a {
    display: inline-block;
    padding: 6px 0;
    font-size: 14px;
    color: var(--link);
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer-brand {
    font:
      46px/1.5 Lora,
      serif;
  }
  address {
    font-style: normal;
    font-size: 14px;
    color: var(--muted);
    margin-top: 12px;
  }
  .footer-meta {
    margin-top: 36px;
    font-size: 12px;
    color: var(--muted);
  }
  .footer-meta a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .demo-note {
    margin-top: 8px;
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    footer {
      padding-block: 60px;
    }
    .footer-links {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .footer-brand {
      font-size: 38px;
    }
  }
</style>
