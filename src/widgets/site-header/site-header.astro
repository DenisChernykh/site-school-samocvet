---
import type { SiteContent } from '@/shared/api/types';
import { withBase } from '@/shared/lib/paths';
import Button from '@/shared/ui/button.astro';
interface Props {
  content: SiteContent;
  overlay?: boolean;
}
const { content, overlay = false } = Astro.props;
const current = Astro.url.pathname.replace(
  import.meta.env.BASE_URL.replace(/\/$/, ''),
  '',
);
const active = (path: string) =>
  current.startsWith(`/${path}`) ? ('page' as const) : undefined;
---

<header class:list={['site-header', { overlay }]} data-site-header>
  <a class="brand" href={withBase()} aria-label="Самоцвет — главная"
    >{content.site.name}</a
  >
  <nav id="site-menu" aria-label="Основная навигация">
    <a href={withBase('about/')} aria-current={active('about/')}>О школе</a>
    <div class="program-nav">
      <div class="program-trigger">
        <a href={withBase('programs/')} aria-current={active('programs/')}
          >Направления</a
        >
        <button
          type="button"
          class="dropdown-toggle"
          aria-label="Раскрыть направления"
          aria-expanded="false"
          aria-controls="program-menu"
          ><span class="chevron" aria-hidden="true"></span></button
        >
      </div>
      <ul id="program-menu" class="program-menu" hidden>
        {
          content.programs.map((program) => (
            <li>
              <a href={withBase(`programs/${program.slug}/`)}>{program.name}</a>
            </li>
          ))
        }
        <li><a href={withBase('programs/')}>Все направления</a></li>
      </ul>
    </div>
    <a href={withBase('life/')} aria-current={active('life/')}>Жизнь школы</a>
    <a href={withBase('events/')} aria-current={active('events/')}>Афиша</a>
    <a href={withBase('contacts/')} aria-current={active('contacts/')}
      >Контакты</a
    >
    <a class="mobile-admission button" href={withBase('admission/')}
      >На экскурсию</a
    >
  </nav>
  <div class="header-action">
    <Button href="admission/">На экскурсию</Button>
  </div>
  <button
    type="button"
    class="menu-toggle"
    aria-label="Открыть меню"
    aria-expanded="false"
    aria-controls="site-menu"><span></span><span></span></button
  >
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const mobileToggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('nav');
  const dropdownToggle =
    header?.querySelector<HTMLButtonElement>('.dropdown-toggle');
  const dropdown = header?.querySelector<HTMLElement>('.program-menu');
  function closeDropdown(restoreFocus = false) {
    dropdownToggle?.setAttribute('aria-expanded', 'false');
    if (dropdown) dropdown.hidden = true;
    if (restoreFocus) dropdownToggle?.focus();
  }
  function closeMobile(restoreFocus = false) {
    mobileToggle?.setAttribute('aria-expanded', 'false');
    mobileToggle?.setAttribute('aria-label', 'Открыть меню');
    header?.classList.remove('menu-visible');
    document.body.classList.remove('menu-open');
    closeDropdown();
    if (restoreFocus) mobileToggle?.focus();
  }
  mobileToggle?.addEventListener('click', () => {
    const open = mobileToggle.getAttribute('aria-expanded') !== 'true';
    mobileToggle.setAttribute('aria-expanded', String(open));
    mobileToggle.setAttribute(
      'aria-label',
      open ? 'Закрыть меню' : 'Открыть меню',
    );
    header?.classList.toggle('menu-visible', open);
    document.body.classList.toggle('menu-open', open);
    if (!open) closeDropdown();
  });
  dropdownToggle?.addEventListener('click', () => {
    const open = dropdownToggle.getAttribute('aria-expanded') !== 'true';
    dropdownToggle.setAttribute('aria-expanded', String(open));
    if (dropdown) dropdown.hidden = !open;
  });
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (!header?.querySelector('.program-nav')?.contains(event.target))
      closeDropdown();
    if (!header?.contains(event.target)) closeMobile();
  });
  header
    ?.querySelector('.program-nav')
    ?.addEventListener('focusout', (event) => {
      if (
        !(event.currentTarget as HTMLElement).contains(
          (event as FocusEvent).relatedTarget as Node | null,
        )
      )
        closeDropdown();
    });
  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closeMobile();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      if (dropdownToggle?.getAttribute('aria-expanded') === 'true')
        closeDropdown(true);
      else if (mobileToggle?.getAttribute('aria-expanded') === 'true')
        closeMobile(true);
    }
    if (
      event.key === 'Tab' &&
      mobileToggle?.getAttribute('aria-expanded') === 'true'
    ) {
      const focusable = Array.from(
        header!.querySelectorAll<HTMLElement>('a, button'),
      ).filter((el) => el.getClientRects().length > 0);
      const first = focusable[0];
      const last = focusable.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
  window
    .matchMedia('(min-width: 1101px)')
    .addEventListener('change', (event) => {
      if (event.matches) closeMobile();
    });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 96px;
    gap: 24px;
    padding: 20px clamp(24px, 6vw, 86px);
    background: var(--cream);
  }
  .site-header.overlay {
    position: absolute;
    inset: 0 0 auto;
    background: transparent;
    color: var(--cream);
  }
  .brand {
    font:
      400 34px/1.1 Lora,
      serif;
    flex-shrink: 0;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  nav > a,
  .program-trigger > a {
    font-size: 16px;
    padding-block: 10px;
  }
  nav a:hover,
  nav a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .program-nav {
    position: relative;
  }
  .program-trigger {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .dropdown-toggle {
    border: 0;
    color: inherit;
    background: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
  }
  .chevron {
    width: 7px;
    height: 7px;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
    transition: transform 180ms;
    margin-top: -4px;
  }
  [aria-expanded='true'] .chevron {
    transform: rotate(225deg);
    margin-top: 4px;
  }
  .program-menu {
    position: absolute;
    top: 100%;
    left: -20px;
    margin: 0;
    list-style: none;
    padding: 12px;
    min-width: 280px;
    background: var(--cream);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 12px 30px #2c2a2712;
    animation: section-arrive 150ms ease;
  }
  .program-menu a {
    display: block;
    padding: 10px 12px;
    border-radius: 6px;
  }
  .program-menu a:hover {
    background: var(--sage);
  }
  .menu-toggle,
  .mobile-admission {
    display: none;
  }
  @media (max-width: 1100px) {
    .site-header {
      padding: 20px 24px;
    }
    .brand {
      font-size: 28px;
    }
    .header-action {
      display: none;
    }
    .menu-toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 7px;
      width: 44px;
      height: 44px;
      padding: 10px;
      border: 0;
      background: transparent;
      color: inherit;
    }
    .menu-toggle span {
      width: 24px;
      height: 1.5px;
      background: currentColor;
      transition: transform 180ms;
    }
    .menu-visible {
      color: var(--ink) !important;
      background: var(--cream) !important;
    }
    .menu-visible .menu-toggle span:first-child {
      transform: translateY(4.25px) rotate(45deg);
    }
    .menu-visible .menu-toggle span:last-child {
      transform: translateY(-4.25px) rotate(-45deg);
    }
    nav {
      display: none;
      position: absolute;
      top: 95px;
      left: 0;
      width: 100%;
      height: calc(100dvh - 95px);
      padding: 24px;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 12px;
      overflow-y: auto;
      background: var(--cream);
      color: var(--ink);
    }
    .menu-visible nav {
      display: flex;
    }
    nav > a,
    .program-trigger > a {
      font-family: Lora, serif;
      font-size: 25px;
      padding: 8px 0;
    }
    .program-trigger {
      justify-content: space-between;
    }
    .program-menu {
      position: static;
      box-shadow: none;
      border: 0;
      border-radius: 0;
      background: transparent;
      padding: 0 0 12px 12px;
      min-width: 0;
    }
    .program-menu a {
      font:
        16px/1.5 Montserrat,
        sans-serif;
      padding: 12px 0;
    }
    .site-header nav .mobile-admission {
      display: inline-flex;
      align-self: flex-start;
      margin-top: 20px;
      font:
        700 14px/1.5 'Open Sans',
        sans-serif;
      padding: 14px 26px;
    }
  }
</style>
